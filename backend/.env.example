# Ambiente
NODE_ENV=development
PORT=3000
TZ=America/Sao_Paulo

# Banco de dados — Postgres local subido via docker-compose na raiz do repo.
# Usuário/senha/banco/porta devem bater com o .env da raiz (POSTGRES_*), que
# é o que o docker-compose.yml realmente usa para subir o container.
DATABASE_URL="postgresql://saude_plena:saude_plena@localhost:5433/saude_plena?schema=public"

# Segredo que assina o cookie de sessão (mínimo 32 caracteres). Gere um valor
# aleatório e único por ambiente — nunca reutilize o de outro ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (No devcontainer, o post-create.sh preenche automaticamente.)
SESSION_SECRET=

# Chave AES-256 que cifra os registros de sessão (prontuário): 32 bytes em hex
# (64 caracteres). Gere com o mesmo comando acima — um valor por ambiente.
# ATENÇÃO: perder esta chave = perder todos os registros cifrados com ela.
# Guarde-a fora do servidor e fora do backup do banco (quem tiver os dois lê
# tudo). (No devcontainer, o post-create.sh preenche automaticamente.)
REGISTRO_CHAVE_V1=

# Lembretes de sessão por e-mail (pacote 1.4.8): `npm run lembretes:enviar`.
# Em desenvolvimento, deixe SMTP_HOST vazio: nenhum e-mail sai de verdade
# (modo simulação). Em produção quem envia é o GitHub Actions
# (.github/workflows/lembretes.yml), com estes valores cadastrados como
# secrets lá — no Render a API não precisa deles.
# Brevo: smtp-relay.brevo.com, porta 587; usuário e senha SMTP ficam em
# "SMTP & API" no painel do Brevo (a senha SMTP NÃO é a senha da conta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente com endereço verificado no Brevo, ex.: "Consultório <lembretes@seudominio.com.br>"
EMAIL_REMETENTE=
# Opcional: para onde vai a resposta do paciente.
EMAIL_RESPONDER_PARA=
# Horas de antecedência do lembrete (1 a 168). Pendente de confirmar com a parceira.
LEMBRETE_ANTECEDENCIA_HORAS=24
