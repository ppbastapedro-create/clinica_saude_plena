generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Todos os DateTime usam Timestamptz(3): o Date do JavaScript tem precisão de
// milissegundos, então guardar microssegundos (6) só criaria uma precisão que
// a aplicação nunca lê nem escreve; e "tz" grava o instante absoluto,
// independente do fuso do servidor.

// ── Usuário (psicólogo ou administrador) ─────────────────────────────
// O sistema suporta vários psicólogos, mas o escopo atual entrega para uma
// só. ADMIN gerencia contas; durante o desenvolvimento tem acesso provisório
// total, e antes da implantação perde acesso a Paciente, RegistroSessao e
// Pagamento — essa checagem de papel fica no service (o banco não a impõe).
enum Papel {
  PSICOLOGO
  ADMIN
}

model Usuario {
  id               Int           @id @default(autoincrement())
  nome             String
  email            String        @unique
  senhaHash        String
  papel            Papel         @default(PSICOLOGO)
  ativo            Boolean       @default(true)
  tentativasFalhas Int           @default(0)
  bloqueadoAte     DateTime?     @db.Timestamptz(3)
  criadoEm         DateTime      @default(now()) @db.Timestamptz(3)
  pacientes        Paciente[]
  agendamentos     Agendamento[]
  recebimentos     Recebimento[]
  logsAcesso       LogAcesso[]
}

// ── Sessão HTTP (connect-pg-simple) ──────────────────────────────────
// Declarada aqui para o Prisma "possuir" a tabela e não acusar drift no
// próximo `prisma migrate dev`. No connect-pg-simple, usar
// `createTableIfMissing: false` — quem cria a tabela é esta migração.
model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamptz(3)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// ── Paciente ──────────────────────────────────────────────────────────
model Paciente {
  id              Int             @id @default(autoincrement())
  psicologoId     Int
  psicologo       Usuario         @relation(fields: [psicologoId], references: [id])
  nome            String
  cpf             String
  email           String?
  telefone        String?
  // Preço padrão da sessão deste paciente (cada paciente tem o seu). Sugerido
  // ao marcar; a sessão guarda o próprio valor (mudar o preço não reescreve
  // o histórico).
  valorSessao     Decimal?        @db.Decimal(10, 2)
  // Lembrete de sessão por e-mail só com opt-in (padrão: não): um e-mail de
  // "lembrete de atendimento" numa caixa compartilhada pode expor que a pessoa
  // faz terapia. A psicóloga marca quando o paciente concordar. Exige e-mail
  // (CHECK manual na migração).
  receberLembrete Boolean         @default(false)
  arquivadoEm     DateTime?       @db.Timestamptz(3) // arquivamento lógico — nunca DELETE
  criadoEm        DateTime        @default(now()) @db.Timestamptz(3)
  agendamentos    Agendamento[]
  consentimentos  Consentimento[]
  recebimentos    Recebimento[]

  // Mesmo CPF pode existir para psicólogos diferentes (cada um tem sua
  // carteira de pacientes), mas não duas vezes para o mesmo psicólogo.
  @@unique([psicologoId, cpf])
  // Alvo da FK composta de Agendamento (ver abaixo).
  @@unique([id, psicologoId])
}

// Histórico de consentimento (LGPD art. 8º, §5º: titular pode revogar)
model Consentimento {
  id          Int       @id @default(autoincrement())
  pacienteId  Int
  paciente    Paciente  @relation(fields: [pacienteId], references: [id])
  versaoTermo String
  aceitoEm    DateTime  @default(now()) @db.Timestamptz(3)
  revogadoEm  DateTime? @db.Timestamptz(3)

  @@index([pacienteId])
}

// ── Agendamento ───────────────────────────────────────────────────────
enum StatusAgendamento {
  AGENDADO
  REALIZADO
  FALTA
  CANCELADO
}

model Agendamento {
  id                Int               @id @default(autoincrement())
  psicologoId       Int
  psicologo         Usuario           @relation(fields: [psicologoId], references: [id])
  pacienteId        Int
  // FK composta: garante que o paciente pertence ao MESMO psicólogo do
  // agendamento — o banco recusa agendar paciente de outro profissional.
  // onUpdate: Restrict — transferir paciente entre psicólogos deve ser um
  // processo explícito, não um cascade silencioso nos agendamentos.
  paciente          Paciente          @relation(fields: [pacienteId, psicologoId], references: [id, psicologoId], onUpdate: Restrict)
  inicio            DateTime          @db.Timestamptz(3)
  fim               DateTime          @db.Timestamptz(3)
  status            StatusAgendamento @default(AGENDADO)
  // Conta corrente do paciente (ver Recebimento): a sessão vira DÉBITO
  // quando é "cobrável". `cobrar` null = regra padrão pelo status (REALIZADO
  // cobra; FALTA não cobra — cobrança de falta pendente com a parceira);
  // true/false = escolha explícita da psicóloga para esta sessão.
  valor             Decimal?          @db.Decimal(10, 2)
  cobrar            Boolean?
  lembreteEnviadoEm DateTime?         @db.Timestamptz(3)
  registroSessao    RegistroSessao?
  logsAcesso        LogAcesso[]
  criadoEm          DateTime          @default(now()) @db.Timestamptz(3)
  // Anti-sobreposição por psicólogo (EXCLUDE USING gist) e CHECK (fim > inicio)
  // são SQL manual acrescentado à migração — o Prisma não expressa nenhum dos dois.

  @@index([pacienteId])
  @@index([psicologoId, inicio])
}

// ── Registro de sessão (dado sensível — LGPD art. 11) ───────────────
model RegistroSessao {
  id              Int         @id @default(autoincrement())
  agendamentoId   Int         @unique
  agendamento     Agendamento @relation(fields: [agendamentoId], references: [id])
  conteudoCifrado Bytes // AES-256-GCM, AAD = agendamentoId
  iv              Bytes
  authTag         Bytes
  versaoChave     Int         @default(1)
  criadoEm        DateTime    @default(now()) @db.Timestamptz(3)
  atualizadoEm    DateTime    @updatedAt @db.Timestamptz(3)
}

// ── Recebimento (conta corrente do paciente) ─────────────────────────
// Substituiu o Pagamento 1:1 por sessão (pacote 1.4.7, 2026-10-25): a
// parceira recebe por pacote (2 ou 4 sessões de uma vez, às vezes adiantado)
// e por sessão avulsa. Saldo do paciente = recebimentos − sessões cobráveis.
// Negativo = a receber; positivo = crédito (pacote pago e ainda não usado).
enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO
  TRANSFERENCIA
}

model Recebimento {
  id             Int            @id @default(autoincrement())
  psicologoId    Int
  psicologo      Usuario        @relation(fields: [psicologoId], references: [id])
  pacienteId     Int
  // FK composta, como em Agendamento: só recebe de paciente do mesmo psicólogo.
  paciente       Paciente       @relation(fields: [pacienteId, psicologoId], references: [id, psicologoId], onUpdate: Restrict)
  valor          Decimal        @db.Decimal(10, 2)
  recebidoEm     DateTime       @db.Timestamptz(3)
  formaPagamento FormaPagamento
  // Quantas sessões o recebimento cobre (informativo — as "chaves" do
  // caderno da parceira). O saldo é calculado pelos valores, não por isto.
  sessoes        Int?
  // Lançamento errado não é apagado: é estornado (fica no histórico).
  estornadoEm    DateTime?      @db.Timestamptz(3)
  criadoEm       DateTime       @default(now()) @db.Timestamptz(3)

  @@index([psicologoId, recebidoEm])
  @@index([pacienteId])
}

// ── Auditoria de acesso ──────────────────────────────────────────────
enum AcaoLog {
  LOGIN
  LOGIN_FALHO
  LOGOUT
  LEITURA_SESSAO
  ESCRITA_SESSAO
}

model LogAcesso {
  id            Int          @id @default(autoincrement())
  usuarioId     Int?
  // onDelete: Restrict — o padrão do Prisma para relação opcional é SetNull,
  // o que apagaria em silêncio o vínculo da trilha de auditoria.
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  agendamentoId Int?
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: Restrict)
  acao          AcaoLog
  criadoEm      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([agendamentoId])
  @@index([criadoEm])
}
