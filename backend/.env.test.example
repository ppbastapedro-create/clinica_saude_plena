# Banco de teste separado — mesma instância do Postgres local, banco
# diferente, pra suíte nunca encostar nos dados de desenvolvimento.
# Criado automaticamente pelo db/init/01-create-test-db.sql (volume novo) ou
# manualmente com `docker compose exec db createdb -U saude_plena saude_plena_test`.
DATABASE_URL="postgresql://app_saude_plena:beatriz@localhost:5432/saude_plena"
