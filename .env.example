# Lido automaticamente pelo docker-compose.yml (fica na raiz do repo) para
# subir o Postgres local. Mantenha os mesmos valores — menos a porta — no
# DATABASE_URL de backend/.env.
#
# POSTGRES_PORT é a porta do HOST (fora do container); dentro do container o
# Postgres continua na 5432 padrão. Ajuste se 5433 também estiver ocupada na
# sua máquina.
POSTGRES_USER=saude_plena
POSTGRES_PASSWORD=saude_plena
POSTGRES_DB=saude_plena
POSTGRES_PORT=5433
